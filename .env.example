# ═══════════════════════════════════════════════════════════════════
#  TON & USDT Exchange Bot — environment template
#
#  Copy it and fill it in:   cp .env.example .env   (then edit .env)
#
#  ⚠️  NEVER commit or share the real .env. It contains the HOT-WALLET
#      MNEMONIC (anyone who sees it can empty the wallet), the bot token
#      and the database password. It is git-ignored, and it must not be
#      downloadable from the internet (README → "6. Web server hardening").
#
#  Only technical and secret values live here. Prices, markup, limits,
#  the card for top-ups, channels and the referral percent are managed
#  from the bot's admin panel (stored in the database).
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────── Telegram ─────────────────────────────

# Token of the bot, issued by @BotFather
BOT_TOKEN=123456789:put-your-botfather-token-here

# Telegram ID(s) of the admin(s), comma-separated: 111111111,222222222
# Send /id to the bot (or ask @userinfobot) to find yours.
ADMIN_IDS=123456789

# ───────────────────────── MySQL / MariaDB ──────────────────────────

# Create a database and a user in your hosting panel (cPanel → MySQL Databases,
# aaPanel → Database) and give the user ALL PRIVILEGES on that database.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exchange_bot
DB_USER=exchange_bot
# Wrap the password in quotes (the characters # : @ / are fine inside them).
# If it contains a $ sign, use single quotes: DB_PASSWORD='pa$$word'
DB_PASSWORD="change-me"
# Some hosts accept only socket connections, e.g.: DB_SOCKET=/var/lib/mysql/mysql.sock
DB_SOCKET=

# (Optional) a ready-made URL instead of the DB_* values above:
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/database?charset=utf8mb4

# ───────────────────── TON hot wallet (holds the funds!) ─────────────────────

# testnet — play money (free test TON: @testgiver_ton_bot)  |  mainnet — REAL money
# Start with testnet and switch to mainnet only after you have tried every flow.
TON_NETWORK=testnet

# Secret words of the bot's own wallet: 12 or 24 words separated by single spaces.
# Tonkeeper wallets: 24 words | Telegram's built-in Gram Wallet: 12 words.
# Use a DEDICATED wallet and keep only the working balance on it — never your main one.
TON_MNEMONIC="word1 word2 word3 ... word24"

# Wallet version: v5r1 (W5 — new Tonkeeper wallets) | v4r2 (older) | tg (Telegram Gram Wallet)
# Not sure which one? Run:  python check_wallet.py
TON_WALLET_VERSION=v5r1

# Mnemonic type: auto (recommended) | ton | multichain
TON_MNEMONIC_TYPE=auto

# TON Center API key — free: open the @toncenter bot in Telegram → Free → Create API Key.
# Works without a key too, but slowly (1 request / second instead of ~7).
TONCENTER_API_KEY=

# USDT (Tether USD₮) jetton master address. The bot uses the official TON mainnet one by default:
#   EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# Set this only if you really need another jetton (e.g. a testnet one) — otherwise leave it commented out.
# USDT_JETTON_MASTER=

# ─────────────────── Payment callback (/pay) ───────────────────

# Your public HTTPS address (no trailing slash). The payment URL shown in the admin panel is
# built from it, and the bot uses it to check that /.env and the source files are NOT downloadable.
PUBLIC_URL=https://example.com

# Shared hosting (cPanel, ...): /pay is served by public/pay.php            → WEB_ENABLED=false
# VPS (nginx reverse proxy → 127.0.0.1:8080): the bot serves /pay itself   → WEB_ENABLED=true
WEB_ENABLED=false
WEB_HOST=127.0.0.1
WEB_PORT=8080

# ───────────────────────────── Optional ─────────────────────────────

# How often rates and the hot-wallet reserve are refreshed (seconds, minimum 20)
RATE_UPDATE_INTERVAL=60

# Lifetime of a top-up invoice (minutes)
PAYMENT_TIMEOUT_MINUTES=5

# Broadcast speed (messages per minute, 1–1500)
BROADCAST_PER_MINUTE=500

TIMEZONE=Asia/Tashkent
