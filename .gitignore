# ───────────── Secrets & local configuration (NEVER commit) ─────────────
# .env holds the hot-wallet mnemonic, the bot token and the database password
.env
.env.*
!.env.example
*.session
*.session-journal

# ───────────────────────────── Python ─────────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ─────────────── Runtime data (created by the bot at run time) ───────────────
# only data/.htaccess is tracked: it keeps the folder closed on Apache / LiteSpeed hosting
data/*
!data/.htaccess
*.log
*.lock
*.sqlite3
*.sqlite3-journal
*.db

# ───────────────────────── OS / editors ─────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
